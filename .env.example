# --- Yapay zekâ sağlayıcısı (zorunlu) ---
# Varsayılan: Google Gemini. Anahtarı https://aistudio.google.com/apikey adresinden alın.
GEMINI_API_KEY=
# Model: gemini-flash-latest (hızlı, ucuz — önerilen) veya gemini-pro-latest (daha güçlü)
GEMINI_MODEL=gemini-flash-latest

# Alternatif sağlayıcı: Anthropic Claude.
# Kullanmak için AI_PROVIDER=claude yapın ve aşağıdaki anahtarı doldurun.
#AI_PROVIDER=claude
#ANTHROPIC_API_KEY=sk-ant-...
#CLAUDE_MODEL=claude-opus-4-8

# --- Yanıtlarda kullanılacak isminiz (imza) ---
USER_NAME=

# Her eşitlemede hesap başına en fazla kaç mail işlensin
SYNC_LIMIT=25

# --- Microsoft 365 / Outlook OAuth (şirket veya kişisel Outlook hesabı için) ---
# Microsoft, Nisan 2026'da IMAP/SMTP için şifreyle girişi kapattı; Outlook
# hesapları yalnızca OAuth ile bağlanır. Ücretsiz Entra ID uygulama kaydı
# oluşturup Application (client) ID'yi buraya yazın — adımlar README'de.
#MS_CLIENT_ID=
# Kiracı: 'common' (varsayılan) kişisel + iş hesaplarını kabul eder.
# Yalnızca şirketinizin kiracısıyla sınırlamak için kiracı ID'nizi yazın.
#MS_TENANT=common

# --- Şifre şifreleme anahtarı (isteğe bağlı ama önerilir) ---
# Hesap/takvim şifreleri veritabanında bu anahtarla şifrelenir.
# Boş bırakılırsa uygulama data/secret.key dosyasını otomatik üretir.
# Anahtarı .env'e taşımak, veritabanı dosyası sızsa bile şifreleri korur.
# Üretmek için: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#MEIL_SECRET_KEY=

# --- Üretim modu (VPS/HTTPS için) ---
# Caddy veya Nginx gibi ters proxy arkasında HTTPS üzerinde çalıştırıyorsanız
# PRODUCTION=true olarak ayarlayın. Bu:
# - Oturum çerezlerine secure=True ve SameSite=Strict ekler
# - Strict-Transport-Security (HSTS) başlığı gönderir
# - Localhost test için False (varsayılan) bırakın.
#PRODUCTION=true

# --- İsteğe bağlı: ilk hesabı buradan otomatik ekleme ---
# Mail hesapları artık arayüzdeki "Hesaplar" sekmesinden ekleniyor
# (Gmail, Outlook/Microsoft 365, şirket maili...). Yine de isterseniz
# ilk hesabı buradan tanımlayabilirsiniz; uygulama açılışta otomatik ekler.
#EMAIL_ADDRESS=ornek@gmail.com
#EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_SECURITY=ssl
